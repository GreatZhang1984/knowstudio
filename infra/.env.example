# 仅本地开发。复制为 infra/.env 后填值；.env 已被 .gitignore 忽略，切勿提交真实凭据。
# 生产凭据由部署环境注入，不走本文件。

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=knowstudio
MYSQL_USER=knowstudio
MYSQL_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 本地默认 knowstudio-dev；如需对外暴露 Grafana，必须改成强密码。
GRAFANA_PASSWORD=

# 应用侧连接串（T-03 / T-04 / T-06 读取）
DATABASE_URL=mysql://knowstudio:@127.0.0.1:3306/knowstudio
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=knowstudio-dev
S3_FORCE_PATH_STYLE=true
